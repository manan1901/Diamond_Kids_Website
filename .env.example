# --- UPI payment settings ---
# "demo" = payment simulate hota hai (koi paisa nahi katta). Real backend ready hone par "live" karo.
VITE_PAYMENT_MODE=demo

# School ka receiving UPI ID (QR code aur UPI app buttons isi par payment bhejte hain)
VITE_SCHOOL_UPI_ID=diamondkidsschool@upi

# Live mode me tumhare FastAPI backend ka base URL
VITE_API_BASE_URL=/api
